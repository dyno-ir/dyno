

CALL symbol("flow_earlyCanonFlow")
CALL symbol("flow_synthCanonicalize")

// get rid of verilog unknown semantics
meta.LOWER_OPS_PASS map(
  "lowerMultiInputAdd"     : "0",
  "lowerAddCompress"       : "0",
  "lowerSimpleAdd"         : "0",
  "lowerSub"               : "0",
  "lowerMul"               : "0",
  "lowerMultiInputBitwise" : "0",
  "lowerEqualityICMP"      : "0",
  "lowerOrderingICMP"      : "0",
  "lowerWildcardCaseICMP"  : "1",
  "lowerShift"             : "0",
  "lowerInsert"            : "0",
  "lowerExtract"           : "0",
  "lowerOneHotMux"         : "0",
)

CALL symbol("flow_synthEarlyOpt")
CALL symbol("flow_synthLowerControlFlow")
CALL symbol("flow_synthMemoryFFMuxHandling")

meta.DUMP_PASS map("path": "xilinx/memories.dyno")
