}

TEST_SCRIPT :string("early-share-extract"), :block {
  PARSE_VERILOG_PASS map("code":[{
    module Test (
      input logic clk,
      input logic sel,
      input logic sel2,
      input logic sel3,
      input logic[255:0] mem,
      input logic[7:0] a,
      input logic[7:0] b,
      input logic[7:0] c,
      input logic[7:0] d,
      output logic[0:0] out
    );

      always_ff@(posedge clk) begin
        if (sel) begin
          if (sel2) out <= mem[a];
          else      out <= {mem+'d1}[b]; // not shared, different content
        end
        else begin
          if (sel3) out <= mem[c];
          else      out <= mem[d];
        end
      end

    endmodule
  }])
  CALL symbol("flow_earlyCanonFlow")
  CALL symbol("flow_synthCanonicalize")
  meta.INACTIVE_COPY_PASS
  CALL symbol("flow_synthEarlyOpt")

  meta.ASSERT_EXISTS_PASS map("regex":
    "SPLICE ([^,]*\,){2} %",
    "excludeRegex": "[\s\S]*__inactive[\s\S]*",
    "num": "2")
  meta.RANDOM_EQUIVALENCE_CHECK_PASS map("cycles": "100", "clockMode": "CLOCK")
}
