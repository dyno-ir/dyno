TEST_SCRIPT :string("strict-verilog-xz-semantics"), :block {
  PARSE_VERILOG_PASS map("strictXZ": "1", "code":[{
    module Test (
      input logic a,
      input logic b,
      output logic x,
      output logic y
    );

    always_comb x = a && b;
    always_comb y = a || b;

    endmodule
  }])
  meta.INACTIVE_COPY_PASS
  // make sure inst combine does not destroy semantics (i.e. frontend adds necessary extra instructions for verilog semantics)
  meta.INST_COMBINE_PASS

  meta.RANDOM_EQUIVALENCE_CHECK_PASS map("cycles": "100", "relaxXZ": "0", "inputXZ": "1")
}

TEST_SCRIPT :string("strict-verilog-xz-semantics2"), :block {
  PARSE_VERILOG_PASS map("strictXZ": "1", "code":[{
    module Test (
      input logic a,
      input logic b,
      input logic c,
      output logic x,
      output logic y
    );

    // unlike ?: this returns b if c is unknown
    always_comb
      if (c) x = a; else x = b;

    always_comb
      y = c ? a : b;

    endmodule
  }])
  meta.INACTIVE_COPY_PASS
  meta.SSA_CONSTRUCT_PASS
  // make sure inst combine does not destroy semantics (i.e. frontend adds necessary extra instructions for verilog semantics)
  meta.INST_COMBINE_PASS
  meta.LINEARIZE_CONTROL_FLOW_PASS

  meta.RANDOM_EQUIVALENCE_CHECK_PASS map("cycles": "100", "relaxXZ": "0", "inputXZ": "1")
}

TEST_CASE :string("test-reg-split"), :block, :block, :block {
  MODULE_DEF :module("Test"), :block {
    INPUT_REGISTER_DEF %clk:register(1)
    INPUT_REGISTER_DEF %addr:register(2)
    INPUT_REGISTER_DEF %in_op:register(1)
    OUTPUT_REGISTER_DEF %out_a:register(1)

    REGISTER_DEF %state:register(4)

    TRIGGER_DEF %trig:trigger(pos), %clk

    COMB_PROCESS_DEF :process, :block {
      LOAD %state_v:wire(4), %state
      LOAD %addr_v:wire(2), %addr
      ZEXT %addr32:wire(32), %addr_v

      GEP %ptr:ptr, #32'd0, %addr32, #32'd1, #32'd4
      SPLICE %bit_v:wire(1), %state_v, %ptr

      STORE %bit_v, %out_a

      LOAD %in_op_v:wire(1), %in_op
      NOT %bit_v_inv:wire(1), %bit_v
      MUX %bit_v_out:wire(1), %in_op_v, #1'b0, %bit_v_inv

      INSERT %res_v:wire(4), %state_v, %bit_v_out, %ptr

      STORE_DEFER %res_v, %state, %trig
    }
  }
}{
  hw.MODULE_DEF %Test:module("Test"), %b1:core.block {
    hw.INPUT_REGISTER_DEF %r0:register(1)
    hw.INPUT_REGISTER_DEF %r1:register(2)
    hw.INPUT_REGISTER_DEF %r2:register(1)
    hw.OUTPUT_REGISTER_DEF %r3:register(1)
    hw.REGISTER_DEF %r4:register(4)
    hw.TRIGGER_DEF %1:trigger(pos), %r0
    hw.COMB_PROCESS_DEF %2:process, %b2:core.block {
      hw.LOAD %w0:wire(4), %r4
      hw.LOAD %w1:wire(2), %r1
      op.ZEXT %w2:wire(32), %w1
      op.TRUNC %w63:wire(1), %w0
      hw.SPLICE %w64:wire(1), %w0, #32'd1
      hw.SPLICE %w65:wire(1), %w0, #32'd2
      hw.SPLICE %w66:wire(1), %w0, #32'd3
      op.TRUNC %w67:wire(1), %w1
      op.NOT %w80:wire(1), %w67
      hw.SPLICE %w79:wire(1), %w1, #32'd1
      op.NOT %w78:wire(1), %w79
      op.AND %w81:wire(1), %w67, %w79
      op.AND %w82:wire(1), %w79, %w80
      op.AND %w85:wire(1), %w67, %w78
      op.OR %w88:wire(1), %w67, %w79
      op.NOT %w89:wire(1), %w88
      hw.ONEHOT_MUX %w87:wire(1), %w89, %w63, %w85, %w64, %w82, %w65, %w81, %w66
      hw.STORE %w87, %r3
      hw.LOAD %w4:wire(1), %r2
      op.OR %w76:wire(1), %w4, %w87
      op.NOT %w77:wire(1), %w76
      op.NOT %w40:wire(32), %w2
      op.TRUNC %w42:wire(1), %w40
      hw.SPLICE %w44:wire(1), %w40, #32'd1
      op.AND %w46:wire(1), %w42, %w79
      op.AND %w47:wire(1), %w44, %w67
      op.AND %w48:wire(1), %w42, %w44
      hw.LOAD %w74:wire(1), %r0
      hw.FLIP_FLOP %w54:wire(1), %w74, %w77, %w48
      hw.FLIP_FLOP %w50:wire(1), %w74, %w77, %w47
      hw.FLIP_FLOP %w45:wire(1), %w74, %w77, %w46
      hw.FLIP_FLOP %w41:wire(1), %w74, %w77, %w81
      hw.CONCAT %w60:wire(4), %w41, %w45, %w50, %w54
      hw.STORE %w60, %r4
    }
  }
}{
  meta.LOWER_OPS_PASS
  meta.INST_COMBINE_PASS map("muxToOneHotMux": "1")
  meta.COMMON_SUBEXPRESSION_ELIMINATION_PASS

  meta.FLIP_FLOP_INFERENCE_PASS
  meta.INST_COMBINE_PASS map("findFlipFlopEnables": "1")
}


TEST_CASE :string("test-ff-sync-rst"), :block, :block, :block {
  MODULE_DEF :module("Test"), :block {
    INPUT_REGISTER_DEF %clk:register(1)
    INPUT_REGISTER_DEF %rst:register(1)
    INPUT_REGISTER_DEF %d:register(1)
    INPUT_REGISTER_DEF %q:register(1)

    COMB_PROCESS_DEF :process, :block {
      LOAD %rst_w:wire(1), %rst
      NOT %rst_w_inv:wire(1), %rst_w

      LOAD %d_w:wire(1), %d
      LOAD %clk_w:wire(1), %clk

      ONEHOT_MUX %d_with_reset:wire(1), %rst_w, #1'd0, %rst_w_inv, %d_w
      FLIP_FLOP %q_w:wire(1), %clk_w, %d_with_reset, #1'd1

      STORE %q_w, %q
    }
  }
}{
  hw.MODULE_DEF %Test:module("Test"), %b1:core.block {
    hw.INPUT_REGISTER_DEF %r0:register(1)
    hw.INPUT_REGISTER_DEF %r1:register(1)
    hw.INPUT_REGISTER_DEF %r2:register(1)
    hw.INPUT_REGISTER_DEF %r3:register(1)
    hw.COMB_PROCESS_DEF %0:process, %b2:core.block {
      hw.LOAD %w0:wire(1), %r1
      hw.LOAD %w2:wire(1), %r2
      hw.LOAD %w3:wire(1), %r0
      hw.FLIP_FLOP_SRST %w6:wire(1), %w3, %w2, #1'd1, %w0, #1'd0
      hw.STORE %w6, %r3
    }
  }
}{
  meta.INST_COMBINE_PASS map("findFlipFlopEnables": "1", "findFlipFlopSyncResets": "1")
}

// lower down to memory mapping
FUNCTION_DEF %memoryTestSynth:func, :block {
  CALL symbol("flow_earlyCanonFlow")
  meta.INACTIVE_COPY_PASS
  CALL symbol("flow_synthCanonicalize")
  CALL symbol("flow_synthEarlyOpt")
  CALL symbol("flow_synthLowerControlFlow")
  CALL symbol("flow_synthMemoryFFMuxHandling")
  CALL symbol("flow_synthLowerMemoryFF")
}
// lift back up for sim
FUNCTION_DEF %memoryTestLift:func, :block {
  meta.LIFT_STD_CELLS_PASS
  meta.SELECT_MODULES_PASS map("regex": "^(?!.*__inactive$).*")
  meta.MODULE_INLINE_PASS
  meta.SELECT_MODULES_PASS map("regex": "Test")
  meta.LOWER_MEM_ACCESS_PASS

  meta.LIFT_FLIP_FLOPS_PASS
  meta.COMMON_SUBEXPRESSION_ELIMINATION_PASS
  meta.INST_COMBINE_PASS
  meta.TRIGGER_DEDUPE_PASS

  meta.PROCESS_LINEARIZE_PASS map("retainIODeps": "0", "retainInnerDeps": "0")
  meta.SSA_CONSTRUCT_PASS
  meta.COMMON_SUBEXPRESSION_ELIMINATION_PASS
  meta.INST_COMBINE_PASS
  meta.AGGRESSIVE_DEAD_CODE_ELIMINATION_PASS

  meta.ORDER_INSTRS_PASS map("assertNoCircularDeps": "1", "moveStoresBeforeLoads": "1")
  meta.SSA_CONSTRUCT_PASS
  meta.COMMON_SUBEXPRESSION_ELIMINATION_PASS
  meta.INST_COMBINE_PASS
  meta.AGGRESSIVE_DEAD_CODE_ELIMINATION_PASS
  meta.TRIGGER_DEDUPE_PASS
}

// Normal synth pipeline down to memory mapping, then lift for simulation.
FUNCTION_DEF %memoryTestSynthRoundTrip:func, :block {
  CALL %memoryTestSynth
  CALL %memoryTestLift
}

TEST_SCRIPT :string("test-memory-different-port-widths"), :block {
  PARSE_VERILOG_PASS map("code":[{
    module Test#(parameter int DEPTH = 128, parameter int WIDTH = 2) (
      input logic clk,
      input logic[$clog2(DEPTH) + $clog2(WIDTH) - 1:0] IN_waddr,
      input logic[0:0] IN_wdata,
      input logic[0:0] IN_wmask,

      input logic[$clog2(DEPTH) - 1:0] IN_raddr,
      output logic[1:0] OUT_rdata
    );

    union packed {
      logic[DEPTH-1:0][WIDTH-1:0] mem;
      logic[(DEPTH*WIDTH)-1:0] flat;
    } u;

    always_ff@(posedge clk)
      if (IN_wmask[0])
        u.flat[IN_waddr] <= IN_wdata;

    always_comb
      OUT_rdata = u.mem[IN_raddr];

    endmodule
  }])

  CALL %memoryTestSynth
  meta.ASSERT_EXISTS_PASS map("regex": "STDCELL_INSTANCE.+%FakeMem_3r1w_1x16.+#4'd0, #4'd0", "num": "16")
  CALL %memoryTestLift
  meta.RANDOM_EQUIVALENCE_CHECK_PASS map("cycles": "10000", "clockMode": "CLOCK")
}

