      input logic[$clog2(DEPTH) - 1:0] IN_waddr,
      input logic[WIDTH-1:0] IN_wdata,
      input logic[WIDTH/BYTE-1:0] IN_wmask,

      input logic[$clog2(DEPTH) - 1:0] IN_raddr,
      output logic[WIDTH-1:0] OUT_rdata
    );

    logic[WIDTH-1:0] mem[DEPTH-1:0];

    always_ff@(posedge clk)
      for (int i = 0; i < WIDTH/BYTE; i++)
        if (IN_wmask[i])
          mem[IN_waddr][i*BYTE+:BYTE] <= IN_wdata[i*BYTE+:BYTE];

    always_comb
      OUT_rdata = mem[IN_raddr];

    endmodule
  }])
  CALL %memoryTestSynth
  meta.ASSERT_EXISTS_PASS map("regex":
    "STDCELL_INSTANCE.+%FakeRAM_288",
    "num": "3")
  CALL %memoryTestLift
  meta.RANDOM_EQUIVALENCE_CHECK_PASS map("cycles": "10000", "clockMode": "CLOCK")
}

TEST_SCRIPT :string("test-memory-byte-write-sync-read-en"), :block {
  PARSE_VERILOG_PASS map("code":[{
    module Test#(parameter int DEPTH = 32, parameter int WIDTH = 15, parameter BYTE = 5) (
      input logic clk,
      input logic[$clog2(DEPTH) - 1:0] IN_waddr,
      input logic[WIDTH-1:0] IN_wdata,
      input logic[WIDTH/BYTE-1:0] IN_wmask,

      input logic[$clog2(DEPTH) - 1:0] IN_raddr,
      input logic IN_re,
      output logic[WIDTH-1:0] OUT_rdata
    );

    logic[WIDTH-1:0] mem[DEPTH-1:0];

    always_ff@(posedge clk)
      for (int i = 0; i < WIDTH/BYTE; i++)
        if (IN_wmask[i])
          mem[IN_waddr][i*BYTE+:BYTE] <= IN_wdata[i*BYTE+:BYTE];

    always_ff@(posedge clk)
      if (IN_re)
        OUT_rdata <= mem[IN_raddr];

    endmodule
  }])
  CALL %memoryTestSynth
  meta.ASSERT_EXISTS_PASS map("regex":
    "STDCELL_INSTANCE.+%FakeRAM_288_syncread",
    "num": "3")
  CALL %memoryTestLift
  meta.RANDOM_EQUIVALENCE_CHECK_PASS map("cycles": "10000", "clockMode": "CLOCK")
}

TEST_SCRIPT :string("test-memory-tdp"), :block {
  PARSE_VERILOG_PASS map("code":[{
  module Test
  #(
      parameter WORD_SIZE=32*4*2,
      parameter NUM_WORDS=128,
      parameter WRITE_SIZE=8
  )
  (
      input wire clk,

      input wire IN_nce,
      input wire IN_nwe,
      input wire[$clog2(NUM_WORDS)-1:0] IN_addr,
      input wire[WORD_SIZE-1:0] IN_data,
      input wire[(WORD_SIZE/WRITE_SIZE)-1:0] IN_wm,
      output reg[WORD_SIZE-1:0] OUT_data,

      input wire IN_nce1,
      input wire[$clog2(NUM_WORDS)-1:0] IN_addr1,
      output reg[WORD_SIZE-1:0] OUT_data1
  );

  reg[WORD_SIZE-1:0] mem[NUM_WORDS-1:0] /* verilator public */;

  reg ce_reg = 1;
  reg ce1_reg = 1;
  reg we_reg;
  reg[$clog2(NUM_WORDS)-1:0] addr_reg;
  reg[$clog2(NUM_WORDS)-1:0] addr1_reg;
  reg[WORD_SIZE-1:0] data_reg;
  reg[(WORD_SIZE/WRITE_SIZE)-1:0] wm_reg;

  always@(posedge clk) begin
      ce_reg <= IN_nce;
      ce1_reg <= IN_nce1;
      we_reg <= IN_nwe;
      addr_reg <= IN_addr;
      addr1_reg <= IN_addr1;
      data_reg <= IN_data;
      wm_reg <= IN_wm;

      if (!ce_reg) begin
          if (!we_reg) begin
              for (integer i = 0; i < WORD_SIZE/WRITE_SIZE; i=i+1) begin
                  if (wm_reg[i])
                      mem[addr_reg][(WRITE_SIZE*i)+:WRITE_SIZE] <= data_reg[(WRITE_SIZE*i)+:WRITE_SIZE];
              end
          end
          else begin
              OUT_data <= mem[addr_reg];
          end
      end

      if (!ce1_reg) begin
          OUT_data1 <= mem[addr1_reg];
      end
  end

  endmodule
  }])
  CALL %memoryTestSynth
  meta.ASSERT_EXISTS_PASS map("regex":
    "STDCELL_INSTANCE.+%RAMB18_TDP",
    "num": "16")
  CALL %memoryTestLift
  meta.RANDOM_EQUIVALENCE_CHECK_PASS map("cycles": "10000", "clockMode": "CLOCK")
}

TEST_SCRIPT :string("early-share-insert"), :block {
  PARSE_VERILOG_PASS map("code":[{
    module Test (
      input logic clk,
      input logic sel,
      input logic sel2,
      input logic sel3,
      input logic[2:0] addr,
      input logic[7:0] a,
      input logic[7:0] b,
      input logic[7:0] c,
      input logic[7:0] d,
      output logic[7:0] out
    );
      logic[7:0] mem;

      always_ff@(posedge clk) begin
        if (sel) begin
          if (sel2) mem[addr] <= a;
          else      mem[addr] <= b;
        end
        else begin
          if (sel3) mem[addr] <= c;
          else      mem[addr] <= d;
        end
      end

      assign out = mem;

    endmodule
  }])
  CALL symbol("flow_earlyCanonFlow")
  CALL symbol("flow_synthCanonicalize")
  meta.INACTIVE_COPY_PASS
  CALL symbol("flow_synthEarlyOpt")

  meta.ASSERT_EXISTS_PASS map("regex":
    // one indexed insert
    "INSERT ([^,]*\,){3} %",
    "excludeRegex": "[\s\S]*__inactive[\s\S]*",
    "num": "1")
  meta.RANDOM_EQUIVALENCE_CHECK_PASS map("cycles": "100", "clockMode": "CLOCK")
}

TEST_SCRIPT :string("early-share-insert-struct"), :block {
  PARSE_VERILOG_PASS map("code":[{
    typedef struct packed {
      logic[7:0] a;
      logic[7:0] b;
    } my_struct;

    module Test (
      input logic clk,
