      input logic sel2,
      input logic sel3,
      input logic[2:0] idx,
      input logic[7:0] a,
      input logic[7:0] b,
      input logic[7:0] c,
      input logic[7:0] d,
      output my_struct out
    );

      my_struct mem[7:0];

      always_ff@(posedge clk) begin
        if (sel) begin
          if (sel2) mem[idx].a <= a;
          else      mem[idx].a <= b;
        end
        else begin
          if (sel3) mem[idx].b <= c;
          else      mem[idx].b <= d;
        end
      end

      assign out = mem[0];

    endmodule
  }])
  CALL symbol("flow_earlyCanonFlow")
  CALL symbol("flow_synthCanonicalize")
  meta.INACTIVE_COPY_PASS
  CALL symbol("flow_synthEarlyOpt")
  meta.ASSERT_EXISTS_PASS map("regex":
    // two indexed inserts
    "INSERT ([^,]*\,){3} %",
    "excludeRegex": "[\s\S]*__inactive[\s\S]*",
    "num": "2")
  meta.RANDOM_EQUIVALENCE_CHECK_PASS map("cycles": "100", "clockMode": "CLOCK")
}

TEST_SCRIPT :string("early-share-add"), :block {
  PARSE_VERILOG_PASS map("code":[{
    module Test (
      input logic clk,
      input logic sel,
      input logic sel2,
      input logic sel3,
      input logic[1:0] addr,
      input logic[7:0] a,
      input logic[7:0] b,
      input logic[7:0] c,
      input logic[7:0] d,
      output logic[31:0] out
    );

      always_ff@(posedge clk) begin
        if (sel) begin
          if (sel2) out[7:0] <= a + b;
          else      out <= c + d;
        end
        else begin
          if (sel3) out <= a + 42;
          else      out <= d - 1;
        end
      end

    endmodule
  }])
